<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="brand"><span class="brand-mark"></span> HirePath</a>
    <nav class="nav-links">
      <a href="/jobs" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/jobs') ? 'active' : '' %>">Browse jobs</a>
      <a href="/#how-it-works">How it works</a>
      <% if (user && user.role === 'admin') { %>
        <a href="/admin" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') ? 'active' : '' %>">Dashboard</a>
      <% } else if (user) { %>
        <a href="/user/dashboard" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/user') ? 'active' : '' %>">My applications</a>
      <% } %>
    </nav>
    <div class="nav-actions">
      <button type="button" class="cmdk-trigger" id="cmdk-trigger" aria-label="Open quick search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span class="mono">⌘K</span>
      </button>
      <% if (!user) { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">Log in</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Get Hired</a>
      <% } else { %>
        <a href="<%= user.role === 'admin' ? '/admin' : '/user/dashboard' %>" class="avatar-chip">
          <span class="avatar-dot" style="background: <%= user.avatarColor || '#3f5eef' %>"><%= user.initials ? user.initials() : user.name.slice(0,2).toUpperCase() %></span>
          <span class="mono" style="font-size:13px;"><%= user.name.split(' ')[0] %></span>
        </a>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
        </form>
      <% } %>
    </div>
  </div>
</header>
