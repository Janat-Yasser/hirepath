<section class="hero">
  <div class="hero-blob-1"></div>
  <div class="hero-blob-2"></div>
  <div class="container hero-grid">
    <div data-reveal>
      <p class="eyebrow on-blue">Hiring, matched by data</p>
      <h1>Good hires start with a portal that does the reading for you.</h1>
      <p class="hero-sub">Post a job, and every resume that comes in is scored against your requirements the moment it lands — so your shortlist is ready before you've had your coffee.</p>

      <form action="/jobs" method="GET" class="search-bar" style="margin-bottom:32px;">
        <div class="field-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9aa1bd" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" name="q" placeholder="Job title or keyword" />
        </div>
        <div class="divider"></div>
        <div class="field-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9aa1bd" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <input type="text" name="location" placeholder="City or remote" />
        </div>
        <button type="submit" class="btn btn-primary magnetic">Search</button>
      </form>

      <div class="hero-stats">
        <div class="hero-stat"><b data-count="1200">0</b><span>Resumes analyzed</span></div>
        <div class="hero-stat"><b data-count="86">0</b><span>Avg. match accuracy %</span></div>
        <div class="hero-stat"><b data-count="4">0</b><span>Minutes to shortlist</span></div>
      </div>
    </div>

    <div data-reveal data-reveal-delay="1">
      <div class="mockup-wrap">
        <div class="mockup-window">
          <div class="mockup-chrome">
            <span class="mockup-dot"></span><span class="mockup-dot"></span><span class="mockup-dot"></span>
            <span class="mono muted" style="font-size:11.5px; margin-left:8px;">hirepath.app/admin</span>
          </div>
          <div class="mockup-body">
            <p class="eyebrow" style="margin-bottom:14px;">Ranked applicants</p>
            <div class="mockup-row">
              <div class="mockup-avatar" style="background:var(--blue-100);"></div>
              <div style="flex:1;"><div class="mockup-line" style="width:64%;"></div><div class="mockup-line" style="width:40%; margin-bottom:0;"></div></div>
              <span class="mockup-badge" style="background:var(--green-100); color:var(--green-600);">92%</span>
            </div>
            <div class="mockup-row">
              <div class="mockup-avatar" style="background:var(--amber-100);"></div>
              <div style="flex:1;"><div class="mockup-line" style="width:54%;"></div><div class="mockup-line" style="width:34%; margin-bottom:0;"></div></div>
              <span class="mockup-badge" style="background:var(--blue-100); color:var(--blue-700);">78%</span>
            </div>
            <div class="mockup-row">
              <div class="mockup-avatar" style="background:var(--red-100);"></div>
              <div style="flex:1;"><div class="mockup-line" style="width:70%;"></div><div class="mockup-line" style="width:30%; margin-bottom:0;"></div></div>
              <span class="mockup-badge" style="background:var(--red-100); color:var(--red-500);">41%</span>
            </div>
          </div>
        </div>

        <div class="floaty-card top">
          <div class="floaty-ring" data-score="87">
            <svg width="44" height="44" viewBox="0 0 44 44">
              <circle class="mini-ring-bg" cx="22" cy="22" r="18" fill="none" stroke="#e7e9f5" stroke-width="4" />
              <circle class="fg" cx="22" cy="22" r="18" fill="none" stroke-width="4" stroke-linecap="round" transform="rotate(-90 22 22)" stroke-dasharray="113" stroke-dashoffset="113" data-circumference="113" />
            </svg>
          </div>
          <div>
            <strong style="font-size:13px; display:block;">Strong match</strong>
            <span class="muted" style="font-size:12px;">React · Node.js</span>
          </div>
        </div>

        <div class="floaty-card bottom">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2ecc71" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
          <div>
            <strong style="font-size:13px; display:block;">Resume analyzed</strong>
            <span class="muted" style="font-size:12px;">3 skills matched</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wave-divider">
    <svg viewBox="0 0 1440 110" preserveAspectRatio="none"><path fill="#ffffff" d="M0,64 C240,110 480,20 720,32 C960,44 1200,110 1440,64 L1440,110 L0,110 Z"/></svg>
  </div>
</section>

<section class="section" style="padding-top:56px;">
  <div class="container">
    <p class="muted mono" style="text-align:center; font-size:12.5px; text-transform:uppercase; letter-spacing:.12em; margin-bottom:28px;">Trusted by fast-moving teams</p>
    <div class="logo-grid" data-reveal>
      <% var companies = [
        { name: 'Northlight', color: '#3f5eef' },
        { name: 'Fjord Labs', color: '#2ecc71' },
        { name: 'Vantage', color: '#f5a524' },
        { name: 'Circuit', color: '#8b5cf6' },
        { name: 'Merit', color: '#0ea5e9' },
        { name: 'Basecamp Co', color: '#ef4444' }
      ]; %>
      <% companies.forEach(function(c){ %>
        <div class="logo-tile">
          <div class="logo-chip" style="background:<%= c.color %>;"><%= c.name.slice(0,1) %></div>
          <span><%= c.name %></span>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-soft" id="how-it-works">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 style="font-size:38px;">Three steps from posting to shortlist</h2>
      <p>No manual screening spreadsheets. Every applicant is analyzed the moment they apply.</p>
    </div>
    <div class="grid-3">
      <div class="card card-flat step-card tilt" data-reveal>
        <span class="step-num">01</span>
        <div class="step-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </div>
        <h3>Describe the role</h3>
        <p>List your requirements and must-have skills — HirePath uses these as the scoring rubric for every applicant.</p>
      </div>
      <div class="card card-flat step-card tilt" data-reveal data-reveal-delay="1">
        <span class="step-num">02</span>
        <div class="step-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <h3>Resumes get scored on arrival</h3>
        <p>Our matching engine reads each resume, extracts real skills, and compares them against the job in seconds.</p>
      </div>
      <div class="card card-flat step-card tilt" data-reveal data-reveal-delay="2">
        <span class="step-num">03</span>
        <div class="step-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Review your best-ranked candidates</h3>
        <p>Your dashboard sorts applicants by match score, so the strongest fits rise to the top automatically.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="flex-between" style="margin-bottom:32px; align-items:flex-end;" data-reveal>
      <div>
        <p class="eyebrow">Open roles</p>
        <h2 style="font-size:32px;">Recently posted</h2>
      </div>
      <a href="/jobs" class="btn btn-outline btn-sm">View all jobs →</a>
    </div>

    <% var palette = ['#3f5eef','#2ecc71','#f5a524','#8b5cf6']; %>
    <% if (typeof featuredJobs !== 'undefined' && featuredJobs.length) { %>
      <% featuredJobs.forEach(function(job, i){ %>
        <a href="/jobs/<%= job._id %>" style="display:block; margin-bottom:16px;">
          <div class="card card-hover tilt">
            <div class="job-card">
              <div class="job-card-main">
                <div class="job-logo" style="background:<%= palette[i % palette.length] %>;"><%= job.company.slice(0,1) %></div>
                <div>
                  <h3><%= job.title %></h3>
                  <div class="job-meta">
                    <span><%= job.company %></span><span><%= job.location %></span><span><%= job.type %></span>
                  </div>
                </div>
              </div>
              <div class="job-salary"><%= job.salaryLabel %></div>
            </div>
          </div>
        </a>
      <% }) %>
    <% } else { %>
      <p class="muted" data-reveal>New roles are posted regularly — <a href="/jobs" style="color:var(--blue-600); text-decoration:underline;">check the full board</a>.</p>
    <% } %>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="card card-flat" style="padding:56px; text-align:center; background: linear-gradient(135deg, var(--blue-700), #4a3fe0); border:none;" data-reveal>
      <p class="eyebrow on-blue">Ready when you are</p>
      <h2 style="font-size:34px; max-width:560px; margin:0 auto 24px; color:#fff;">Stop reading every resume yourself.</h2>
      <div class="hero-actions" style="justify-content:center; margin-bottom:0;">
        <a href="/auth/register" class="btn btn-primary">Create a free account</a>
        <a href="/jobs" class="btn btn-outline-white">See open roles</a>
      </div>
    </div>
  </div>
</section>
