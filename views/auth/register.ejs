<section class="auth-shell">
  <div class="auth-visual">
    <div class="hero-blob-1" style="top:-100px; right:-100px;"></div>
    <div class="hero-blob-2" style="bottom:-140px; left:-140px;"></div>
    <div style="position:relative; z-index:1;">
      <p class="eyebrow on-blue">Get started</p>
      <h2 style="font-size:34px; max-width:380px; color:#fff;">Apply with confidence, or hire with clarity.</h2>
      <p style="max-width:380px; color:#d9e0ff;">One account, two experiences — a candidate dashboard that tracks your match scores, or a recruiter dashboard that ranks applicants for you.</p>
    </div>
  </div>
  <div class="auth-form-side">
    <div class="auth-box">
      <h1 style="font-size:28px; margin-bottom:6px;">Create your account</h1>
      <p class="muted" style="margin-bottom:28px;">Already have one? <a href="/auth/login" style="color:var(--blue-600); font-weight:600;">Log in</a></p>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <form action="/auth/register" method="POST">
        <div class="field">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" placeholder="Jordan Ellis" value="<%= values.name || '' %>" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" value="<%= values.email || '' %>" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="At least 6 characters" required />
        </div>
        <div class="field">
          <label>I'm signing up as</label>
          <div class="field-row">
            <label class="checkbox-row card" style="padding:12px 14px; cursor:pointer;">
              <input type="radio" name="role" value="user" checked /> Job seeker
            </label>
            <label class="checkbox-row card" style="padding:12px 14px; cursor:pointer;">
              <input type="radio" name="role" value="admin" /> Recruiter
            </label>
          </div>
          <p class="hint">Recruiter accounts need an invite code from your team admin.</p>
        </div>
        <div class="field">
          <input type="text" name="recruiterCode" placeholder="Recruiter invite code (if applicable)" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create account</button>
      </form>
    </div>
  </div>
</section>
