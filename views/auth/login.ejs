<section class="auth-shell">
  <div class="auth-visual">
    <div class="hero-blob-1" style="top:-100px; right:-100px;"></div>
    <div class="hero-blob-2" style="bottom:-140px; left:-140px;"></div>
    <div style="position:relative; z-index:1;">
      <p class="eyebrow on-blue">Welcome back</p>
      <h2 style="font-size:34px; max-width:380px; color:#fff;">Your shortlist has kept working while you were away.</h2>
      <p style="max-width:380px; color:#d9e0ff;">Log in to see newly scored applications and manage your open roles.</p>
    </div>
  </div>
  <div class="auth-form-side">
    <div class="auth-box">
      <h1 style="font-size:28px; margin-bottom:6px;">Log in</h1>
      <p class="muted" style="margin-bottom:28px;">New to HirePath? <a href="/auth/register" style="color:var(--blue-600); font-weight:600;">Create an account</a></p>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <form action="/auth/login" method="POST">
        <input type="hidden" name="next" value="<%= next %>" />
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </form>

      <p class="muted mono" style="font-size:12px; margin-top:24px;">Demo admin: admin@hirepath.dev / Admin123!</p>
    </div>
  </div>
</section>
