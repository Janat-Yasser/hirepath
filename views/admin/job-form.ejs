<section class="dash-shell">
  <%- include('../partials/admin-sidebar') %>

  <div class="dash-main">
    <div class="dash-header">
      <div>
        <p class="eyebrow"><%= job ? 'Edit posting' : 'New posting' %></p>
        <h1 style="font-size:28px;"><%= job ? 'Edit job' : 'Post a new job' %></h1>
      </div>
      <a href="/admin" class="btn btn-ghost btn-sm">← Back to dashboard</a>
    </div>

    <% if (error) { %><div class="alert alert-error" style="max-width:720px;"><%= error %></div><% } %>

    <form action="<%= job && job._id ? '/admin/jobs/' + job._id + '?_method=PUT' : '/admin/jobs' %>" method="POST" style="max-width:720px;">
      <div class="card" style="margin-bottom:20px;">
        <h3 style="margin-bottom:18px;">Basics</h3>
        <div class="field-row">
          <div class="field">
            <label for="title">Job title</label>
            <input type="text" id="title" name="title" value="<%= job ? job.title : '' %>" placeholder="Frontend Engineer" required />
          </div>
          <div class="field">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" value="<%= job ? job.company : '' %>" placeholder="Your company" required />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= job ? job.location : '' %>" placeholder="Remote, or a city" required />
          </div>
          <div class="field">
            <label for="department">Department</label>
            <input type="text" id="department" name="department" value="<%= job ? job.department : '' %>" placeholder="Engineering" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="type">Employment type</label>
            <select id="type" name="type">
              <% ['Full-time','Part-time','Contract','Internship','Remote'].forEach(function(t){ %>
                <option value="<%= t %>" <%= job && job.type === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="experienceLevel">Experience level</label>
            <select id="experienceLevel" name="experienceLevel">
              <% ['Entry','Mid','Senior','Lead'].forEach(function(l){ %>
                <option value="<%= l %>" <%= job && job.experienceLevel === l ? 'selected' : '' %>><%= l %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="salaryMin">Salary min (USD)</label>
            <input type="number" id="salaryMin" name="salaryMin" value="<%= job ? job.salaryMin : '' %>" placeholder="80000" />
          </div>
          <div class="field">
            <label for="salaryMax">Salary max (USD)</label>
            <input type="number" id="salaryMax" name="salaryMax" value="<%= job ? job.salaryMax : '' %>" placeholder="110000" />
          </div>
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="open" <%= job && job.status === 'open' ? 'selected' : '' %>>Open</option>
            <option value="closed" <%= job && job.status === 'closed' ? 'selected' : '' %>>Closed</option>
          </select>
        </div>
      </div>

      <div class="card" style="margin-bottom:20px;">
        <h3 style="margin-bottom:18px;">Description</h3>
        <div class="field">
          <label for="description">Overview</label>
          <textarea id="description" name="description" placeholder="What is this role about?" required><%= job ? job.description : '' %></textarea>
        </div>
        <div class="field">
          <label for="responsibilities">Responsibilities <span class="hint">(one per line)</span></label>
          <textarea id="responsibilities" name="responsibilities" placeholder="Own feature delivery end to end&#10;Collaborate with design"><%= job && Array.isArray(job.responsibilities) ? job.responsibilities.join('\n') : (job ? job.responsibilities : '') %></textarea>
        </div>
        <div class="field">
          <label for="requirements">Requirements <span class="hint">(one per line)</span></label>
          <textarea id="requirements" name="requirements" placeholder="3+ years of React experience&#10;Comfortable with REST APIs"><%= job && Array.isArray(job.requirements) ? job.requirements.join('\n') : (job ? job.requirements : '') %></textarea>
        </div>
      </div>

      <div class="card" style="margin-bottom:24px;">
        <h3 style="margin-bottom:10px;">Matching skills</h3>
        <p class="muted" style="margin-bottom:16px;">These power the AI match score — list the concrete skills that matter most, one per line (e.g. <span class="mono">react</span>, <span class="mono">node.js</span>, <span class="mono">sql</span>).</p>
        <div class="field">
          <textarea id="skills" name="skills" placeholder="react&#10;typescript&#10;mongodb"><%= job && Array.isArray(job.skills) ? job.skills.join('\n') : (job ? job.skills : '') %></textarea>
        </div>
      </div>

      <button type="submit" class="btn btn-primary"><%= job && job._id ? 'Save changes' : 'Publish job' %></button>
    </form>
    <% if (job && job._id) { %>
      <form action="/admin/jobs/<%= job._id %>?_method=DELETE" method="POST" style="display:inline; margin-top:12px;" onsubmit="return confirm('Delete this job and all its applications?');">
        <button type="submit" class="btn btn-danger-ghost">Delete job</button>
      </form>
    <% } %>
  </div>
</section>
