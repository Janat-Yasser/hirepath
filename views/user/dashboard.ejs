<section class="dash-shell">
  <%- include('../partials/user-sidebar') %>

  <div class="dash-main">
    <div class="dash-header">
      <div>
        <p class="eyebrow">Candidate dashboard</p>
        <h1 style="font-size:28px;">Your applications</h1>
      </div>
      <a href="/jobs" class="btn btn-primary">Browse open roles</a>
    </div>

    <div class="stat-strip">
      <div class="stat-box"><div class="n" data-count="<%= stats.total %>">0</div><div class="l">Total applications</div></div>
      <div class="stat-box"><div class="n" data-count="<%= stats.pending %>">0</div><div class="l">Awaiting review</div></div>
      <div class="stat-box"><div class="n" data-count="<%= stats.shortlisted %>">0</div><div class="l">Shortlisted</div></div>
      <div class="stat-box"><div class="n" data-count="<%= stats.avgMatch %>">0</div><div class="l">Avg. match score</div></div>
    </div>

    <% if (!applications.length) { %>
      <div class="empty-state">
        <h3>No applications yet</h3>
        <p class="muted">Once you apply to a role, your match score and status will show up here.</p>
        <a href="/jobs" class="btn btn-primary btn-sm">Find a role</a>
      </div>
    <% } %>

    <% applications.forEach(function(app){ %>
      <div class="app-row">
        <div class="mini-ring" data-score="<%= app.matchScore %>">
          <svg width="52" height="52" viewBox="0 0 52 52">
            <circle class="bg" cx="26" cy="26" r="22" />
            <circle class="fg" cx="26" cy="26" r="22" stroke-dasharray="138.2" stroke-dashoffset="138.2" data-circumference="138.2" />
          </svg>
          <div class="val"><%= app.matchScore %></div>
        </div>
        <div>
          <a href="/jobs/<%= app.job._id %>"><strong style="font-size:15px;"><%= app.job.title %></strong></a>
          <p class="muted" style="margin:2px 0 0; font-size:13px;"><%= app.job.company %> · Applied <%= new Date(app.createdAt).toLocaleDateString() %></p>
        </div>
        <span class="status-pill status-<%= app.status %>"><%= app.status %></span>
        <span></span><span></span>
      </div>
    <% }) %>
  </div>
</section>
