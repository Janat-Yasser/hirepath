<section class="dash-shell">
  <%- include('../partials/user-sidebar') %>

  <div class="dash-main">
    <div class="dash-header">
      <div>
        <p class="eyebrow">Your profile</p>
        <h1 style="font-size:28px;">Profile settings</h1>
      </div>
    </div>

    <% if (success) { %><div class="alert alert-success" style="max-width:520px;">Your profile was updated.</div><% } %>
    <% if (error) { %><div class="alert alert-error" style="max-width:520px;"><%= error %></div><% } %>

    <form action="/user/profile?_method=PUT" method="POST" class="card" style="max-width:520px;">
      <div class="field">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" value="<%= user.name %>" required />
      </div>
      <div class="field">
        <label for="title">Headline</label>
        <input type="text" id="title" name="title" value="<%= user.title || '' %>" placeholder="Frontend Developer" />
      </div>
      <div class="field">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= user.location || '' %>" placeholder="Berlin, Germany" />
      </div>
      <div class="field">
        <label for="bio">Short bio</label>
        <textarea id="bio" name="bio" placeholder="Tell recruiters a bit about yourself"><%= user.bio || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Save changes</button>
    </form>

    <% if (user.skills && user.skills.length) { %>
      <div class="card" style="max-width:520px; margin-top:20px;">
        <h3 style="margin-bottom:6px;">Skills detected from your resume</h3>
        <p class="muted" style="margin-bottom:14px;">These update automatically the next time you apply with a new resume.</p>
        <div class="job-tags">
          <% user.skills.forEach(function(s){ %><span class="tag tag-good"><%= s %></span><% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>
