NODE_ENV=development
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hirepath

# JWT secret used to sign auth tokens - change this in production
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# One-time admin bootstrap (used by npm run seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@hirepath.dev
ADMIN_PASSWORD=Admin123!

# Optional: invite code required to self-register as a recruiter/admin.
# Leave blank during local development to allow open recruiter signups.
RECRUITER_SIGNUP_CODE=
