NODE_ENV=development
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hirepath

# JWT secret used to sign auth tokens - change this in production
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# One-time admin bootstrap (used by npm run seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@hirepath.dev
ADMIN_PASSWORD=Admin123!

# Invite code required to self-register as a recruiter/admin.
# If blank, recruiter sign-up is open ONLY when NODE_ENV=development (never in production).
RECRUITER_SIGNUP_CODE=
